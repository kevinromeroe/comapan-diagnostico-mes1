# =============================================================
# Plantilla de variables de entorno
#
# Copiala a .env.local y rellena los valores reales.
# .env.local está en .gitignore y nunca se commitea.
# =============================================================

# Apify — token con permisos de lectura sobre los actores configurados
APIFY_TOKEN=apify_api_...

# Supabase — base de datos de posts, cuentas y agregados (ingesta, build y evolución)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role JWT>

# Gemini — provider LLM por defecto (taggeo de posts, hallazgos y narrativas)
GEMINI_API_KEY=

# GitHub — PAT con permisos Contents R/W sobre kevinromeroe/comapan-diagnostico-mes1
GH_DEPLOY_TOKEN=github_pat_...

# Google Analytics 4 — service account JSON (cuando esté disponible)
# Pegar el contenido completo del JSON como string (preservar \n como \\n)
GA4_SERVICE_ACCOUNT_JSON=

# Anthropic API (opcional) — solo si el provider LLM del cliente se cambia a "anthropic"
ANTHROPIC_API_KEY=sk-ant-...

# SMTP — para notificaciones de cierre de run
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Slack (opcional)
SLACK_WEBHOOK_URL=
